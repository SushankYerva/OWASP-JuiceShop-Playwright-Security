{
  "name": "playwright-security-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    
    "test:smoke": "playwright test --grep @smoke",
    "test:anonymous": "playwright test --project=chromium-anonymous",
    "test:authenticated": "playwright test --project=chromium-authenticated",
    "test:headed": "playwright test --headed",
    
    
    "report": "playwright show-report reports/html",
    "test:api": "playwright test --project=api",
    "test:api:parallel": "playwright test --project=api --workers=4",

    "test:security": "playwright test tests/security --project=chromium && playwright test tests/security --project=api",

    "test:security:browser": "playwright test tests/security --project=chromium",

    "test:security:api": "playwright test tests/security --project=api",

    "test:security:headed": "playwright test tests/security --project=chromium --headed"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "globals": "^17.11.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
