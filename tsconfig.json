{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@config/*": ["./config/*"],

      "@framework/*": ["./framework/*"],
      "@fixtures/*": ["./framework/fixtures/*"],
      "@helpers/*": ["./framework/helpers/*"],
      "@pages/*": ["./framework/pages/*"],
      "@components/*": ["./framework/components/*"],
      "@api/*": ["./framework/api/*"],
      "@data/*": ["./framework/data/*"],
      "@utils/*": ["./framework/utils/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "config/**/*.ts",
    "tests/**/*.ts"
,   "framework/**/*.ts"  ]
}